<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/media3_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/media3_controls"
        app:animation_enabled="false"
        app:auto_show="false"
        app:play_icon="@drawable/ic_player_play"
        app:pause_icon="@drawable/ic_player_pause"
        app:show_next_button="false"
        app:show_previous_button="false" />

    <TextView
        android:id="@+id/media3_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="@android:color/white"
        android:background="#99000000"
        android:accessibilityLiveRegion="polite"
        android:textSize="16sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/media3_lock"
        style="@style/Media3ControlButton"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/media3_player_lock"
        android:src="@drawable/ic_player_unlock" />
</FrameLayout>
